[
  {
    "conname": "habit_attendance_attendance_date_habit_program_id_student_i_key",
    "definition": "UNIQUE (attendance_date, habit_program_id, student_id)"
  },
  {
    "conname": "habit_attendance_habit_program_id_fkey",
    "definition": "FOREIGN KEY (habit_program_id) REFERENCES habit_programs(id) ON DELETE RESTRICT"
  },
  {
    "conname": "habit_attendance_late_minutes_check",
    "definition": "CHECK (((late_minutes IS NULL) OR (late_minutes >= 0)))"
  },
  {
    "conname": "habit_attendance_pkey",
    "definition": "PRIMARY KEY (id)"
  },
  {
    "conname": "habit_attendance_recorded_by_fkey",
    "definition": "FOREIGN KEY (recorded_by) REFERENCES profiles(id) ON DELETE SET NULL"
  },
  {
    "conname": "habit_attendance_status_check",
    "definition": "CHECK ((status = ANY (ARRAY['HADIR'::text, 'TERLAMBAT'::text, 'SAKIT'::text, 'IZIN'::text, 'ALFA'::text])))"
  },
  {
    "conname": "habit_attendance_student_id_fkey",
    "definition": "FOREIGN KEY (student_id) REFERENCES students(id) ON DELETE CASCADE"
  }
]

